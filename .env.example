# Copy this file to .env and fill in what you need. Everything is optional
# unless noted — the site works with zero keys (except the AI).

PORT=3000
# mainnet | testnet
DEFAULT_NETWORK=mainnet

# ---- Robinhood Chain RPC (strongly recommended) ----
# The public RPC works but is rate-limited. The indexer reads every block,
# so a private RPC keeps it stable. Free: https://www.alchemy.com → create an app
# on "Robinhood Chain" (mainnet) and/or "Robinhood Chain Testnet".
ALCHEMY_API_KEY=
# Or any other RPC URLs, comma-separated (tried in order before the public one):
RH_MAINNET_RPC=
RH_TESTNET_RPC=

# ---- Indexer ----
# sample (default): reads the newest block every few seconds, fits free RPC plans.
# full: reads every block + token logs. Robinhood Chain makes ~10 blocks/s, so use a paid RPC.
INDEXER_MODE=sample
# Networks to index (comma-separated). Index only mainnet to halve RPC usage.
INDEXER_NETWORKS=mainnet,testnet
INDEXER_INTERVAL_MS=
# Blocks per RPC batch. Lower it (e.g. 10) if your RPC rejects big batches.
INDEXER_BATCH=20

# ---- Blockscout explorer API (optional) ----
# Network totals, daily transaction chart, top tokens, address history, and the
# live feed when the RPC is unreachable. A free PRO key (proapi_…) from
# https://dev.blockscout.com uses the hosted API at api.blockscout.com.
BLOCKSCOUT_API_KEY=

# ---- CoinGecko (optional) ----
# Only used for the ETH/USD rate (fees and balances in dollars). Works without a key.
# Free Demo key: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ---- Network AI ----
# Providers are tried in this order; one that is rate-limited or down hands
# the question to the next. Only providers with a key are used.
AI_PROVIDERS=anthropic,gemini,gemini-lite,openrouter

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Fallback on the same key (separate free-tier quota)
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# OpenRouter (free models, ~50 requests/day on the free tier): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Anthropic Claude (paid per use, strongest; adds web search): https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_WEB_SEARCH=true

# Per visitor IP
AI_MAX_REQUESTS=15
AI_WINDOW_MINUTES=10
# Global ceiling on AI requests per UTC day, across all visitors (protects free quotas)
AI_DAILY_LIMIT=400
